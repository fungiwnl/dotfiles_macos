#!/usr/bin/env bash
# Block commits that stage secrets (tokens, keys, certs). Bypass a false
# positive with `git commit --no-verify` or a .gitleaksignore entry.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks); skipping secret scan." >&2
  exit 0
fi

exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
